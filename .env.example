# Database Configuration
POSTGRES_DB=railway-logbook
DB_USER=railways_user
DB_PASSWORD=your_secure_password_here

# JWT Secret: at least 32 bytes, or the production server refuses to start.
# Generate one with: openssl rand -base64 48
JWT_SECRET=your_jwt_secret_here

# Map data pipeline (osmium-scripts/prepare.sh): directories that keep the raw
# Geofabrik extracts so each run applies daily diffs instead of downloading
# ~35GB. Each must exist (on a volume, a directory inside its mount point);
# an optional cap in GB follows a colon. Needs pyosmium-up-to-date. Leave
# unset to download every run.
# RAW_CACHE="data/raw /mnt/volume/osm-raw"
